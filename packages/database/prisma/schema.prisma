generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")

  designs Design[]
  orders  Order[]
  cart    Cart?

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  designId   String   @map("design_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id])

  @@map("cart_items")
}

model SizePreset {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  widthMm    Decimal  @map("width_mm") @db.Decimal(10, 2)
  heightMm   Decimal  @map("height_mm") @db.Decimal(10, 2)
  basePrice  Decimal  @map("base_price") @db.Decimal(12, 2)

  designs Design[]

  @@map("size_presets")
}

model CoverFinish {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  priceModifier  Decimal  @map("price_modifier") @db.Decimal(12, 2)

  designs Design[]

  @@map("cover_finishes")
}

model Material {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  type            MaterialType
  isActive        Boolean  @default(true) @map("is_active")
  pricePerUnit    Decimal  @map("price_per_unit") @db.Decimal(12, 2)
  thicknessMm     Decimal? @map("thickness_mm") @db.Decimal(8, 3)
  paperCaliperMm  Decimal? @map("paper_caliper_mm") @db.Decimal(8, 5)

  paperDesigns Design[] @relation("PaperMaterial")
  boardDesigns Design[] @relation("BoardMaterial")

  @@map("materials")
}

enum MaterialType {
  PAPER
  BOARD
  ENDPAPER
}

model Accessory {
  id       String   @id @default(uuid())
  code     String   @unique
  type     AccessoryType
  name     String
  colorHex String   @map("color_hex")
  price    Decimal  @db.Decimal(12, 2)
  isActive Boolean  @default(true) @map("is_active")

  @@map("accessories")
}

enum AccessoryType {
  STRAP
  RIBBON
}

model Design {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  name            String
  sizePresetId    String        @map("size_preset_id")
  coverFinishId   String        @map("cover_finish_id")
  paperMaterialId String        @map("paper_material_id")
  boardMaterialId String        @map("board_material_id")
  pages           Int
  layout          Layout        @default(PLAIN)
  designPayload   Json          @map("design_payload")
  finishZones     Json?         @map("finish_zones")
  finishConfig    Json?         @map("finish_config")
  thumbnailUrl    String?       @map("thumbnail_url")
  totalPrice      Decimal        @map("total_price") @db.Decimal(12, 2)
  spineWidthMm    Decimal        @map("spine_width_mm") @db.Decimal(8, 3)
  status          DesignStatus   @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  sizePreset   SizePreset    @relation(fields: [sizePresetId], references: [id])
  coverFinish  CoverFinish   @relation(fields: [coverFinishId], references: [id])
  paper        Material      @relation("PaperMaterial", fields: [paperMaterialId], references: [id])
  board        Material      @relation("BoardMaterial", fields: [boardMaterialId], references: [id])
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@map("designs")
}

enum Layout {
  PLAIN
  LINED
}

enum DesignStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

model Order {
  id                   String          @id @default(uuid())
  userId               String         @map("user_id")
  orderNumber          String         @unique @map("order_number")
  productionStatus     ProductionStatus @default(AWAITING_PAYMENT) @map("production_status")
  productionZipUrl     String?        @map("production_zip_url")
  midtransTransactionId String?       @map("midtrans_transaction_id")
  midtransPaymentType  String?        @map("midtrans_payment_type")
  createdAt            DateTime       @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]
  jobs   JobQueue[]

  @@map("orders")
}

enum ProductionStatus {
  AWAITING_PAYMENT
  QUEUED
  BINDING
  SHIPPED
  CANCELLED
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId          String  @map("order_id")
  designId         String  @map("design_id")
  quantity         Int     @default(1)
  baseSnapshot     Json    @map("base_snapshot")
  designSnapshot   Json    @map("design_snapshot")
  finishSnapshot   Json    @map("finish_snapshot")
  finishZonesSnapshot Json? @map("finish_zones_snapshot")
  spineWidthMm     Decimal @map("spine_width_mm") @db.Decimal(8, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id])

  @@map("order_items")
}

model JobQueue {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    JobStatus   @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  createdAt DateTime    @default(now()) @map("created_at")
  startedAt DateTime?  @map("started_at")
  finishedAt DateTime? @map("finished_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("job_queue")
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
